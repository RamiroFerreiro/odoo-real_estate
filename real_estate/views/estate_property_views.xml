<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Acción -->
        <record id="estate_property_action" model="ir.actions.act_window">
            <field name="name">Propiedades</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- VISTA DE BUSQUEDA -->
        <record id="estate_property_search_view" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Buscar Propiedades">

                    <!-- Campos de búsqueda -->
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="facades"/>
                
                    <!-- Filtros y agrupaciones -->
                    <filter string="Mis Propiedades" name="filter_my_properties" domain="[('create_uid','=',uid)]"/>
                    <filter string="Propiedades Disponibles" name="filter_available_properties" domain="[('state','in', ['new', 'offer_received'])]"/>
                    
                    <filter string="Agrupar por Usuario" name="groupby_users" context="{'group_by':'create_uid'}"/>
                    <filter string="Agrupar por fecha" name="groupby_date" context="{'group_by':'create_date:date'}"/>
                    <filter string="Agrupar por codigo postal" name="groupby_postcode" context="{'group_by':'postcode'}"/>
                    <filter string="Agrupar por estado" name="groupby_state" context="{'group_by':'state'}"/>
                    
                </search>
            </field>
        </record>


        <!-- VISTA DE LISTA -->
        <record id="estate_property_list" model="ir.ui.view">
            <field name="name">estate.property.list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">

                <list string="Lista de propiedades">
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="selling_price"/>
                    <field name="date_availability"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                </list>

            </field>
        </record>

        <!-- VISTA DE FORMULARIO -->
        <record id="view_estate_property_form" model="ir.ui.view">
            <field name="name">view.estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">

                <form string="Formulario de propiedades">
                    <header>

                        <button name = "action_mark_as_sold"
                                type = "object"
                                string = "Marcar como vendida"
                                class = "btn-primary"
                        />

                        <button name = "action_mark_as_canceled"
                                type = "object"
                                string = "Marcar como cancelada"
                                class = "btn-secondary"
                        />

                        <button name = "action_random_offer"
                                type = "object"
                                string = "Generar oferta automática"
                                class = "btn-secondary"
                        />

                        <button name = "action_clear_tags"
                                type = "object"
                                string = "Sacar etiquetas"
                                class = "btn-secondary"
                        />

                        <button name = "action_link_tags"
                                type = "object"
                                string = "Cargar todas las etiquetas"
                                class = "btn-secondary"
                        />

                        <button name = "action_brand_new"
                                type = "object"
                                string = "A estrenar"
                                class = "btn-secondary"
                        />
                        
                        <field name="state" widget="statusbar"/>

                    </header>

                    <sheet>

                        <widget name="web_ribbon" title="Vendida" bg_color="text-bg-success" invisible="state != 'sold'"/> 
                        <widget name="web_ribbon" title="Cancelada" bg_color="text-bg-danger" invisible= "state != 'canceled'" />
                        
                        <group>
                            <h1>
                                <field name="name" placeholder="Nombre propiedad"/>
                            </h1>
                        </group>
                        
                        <group>
                            <h3>
                                <field name="tag_ids" placeholder="Etiquetas de propiedad" widget="many2many_tags"/>
                            </h3>
                        </group>

                        <group>
                            <group>
                                <field name="property_type_id"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="selling_price"/>
                                <field name="best_offer"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Descripción">
                                <group>
                                    <group>
                                        <field name="description"/>
                                        <field name="bedrooms"/>
                                        <field name="living_area"/>
                                        <field name="facades"/>
                                        <field name="garage"/>
                                    </group>
                                    <group>
                                        <field name="garden"/>
                                        <field name="garden_area"/>
                                        <field name="garden_orientation"/>
                                        <field name="total_area"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Ofertas">
                                <field name="offer_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>

            </field>
        </record>
    </data>
</odoo>